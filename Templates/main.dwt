<script>
/* Marks the current section in the navigation (works on GitHub Pages and in local preview). */
(function () {
  var segs = location.pathname.split('/').filter(Boolean);
  var last = (segs[segs.length - 1] || '').replace(/\.html$/, '');
  var parent = segs.length > 1 ? segs[segs.length - 2] : '';
  var section = (last === '' || last === 'index') ? 'home' : (parent === 'projects' ? 'projects' : last);
  var links = document.querySelectorAll('.site-nav a[data-section]');
  for (var i = 0; i < links.length; i++) {
    if (links[i].getAttribute('data-section') === section) { links[i].setAttribute('aria-current', 'page'); }
  }
})();
</script>
